{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-resources.ts",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=build/** --test-coverage-exclude=**/*.test.* src/lib/*.test.js src/lib/*.test.ts src/data/*.test.js",
    "typecheck": "tsc --noEmit",
    "preview": "react-router-serve ./build/server/index.js",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "video:studio": "npm --prefix videos/tech-retail run dev",
    "video:render": "npm --prefix videos/tech-retail run render:4k && npm --prefix videos/tech-retail run publish:web",
    "build:vercel": "node scripts/build-vercel.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-toast": "^1.2.14",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.102.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@vercel/react-router": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.544.0",
    "postprocessing": "^6.39.1",
    "react": "^19.1.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.1.1",
    "react-router": "7.18.5",
    "react-type-animation": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@netlify/vite-plugin-react-router": "4.0.0",
    "@react-router/dev": "7.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
